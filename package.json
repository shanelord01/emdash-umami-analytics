{
	"name": "@eisbachcode/emdash-plugin-analytics",
	"version": "0.3.0",
	"description": "EmDash plugin: Cloudflare Web Analytics or Umami on the dashboard and next to your content.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"cms",
		"plugin",
		"analytics",
		"cloudflare",
		"umami",
		"dashboard"
	],
	"license": "MIT",
	"author": "Eisbachcode <daniel@eisbachcode.de>",
	"homepage": "https://github.com/eisbachcode/emdash-plugin-analytics#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eisbachcode/emdash-plugin-analytics.git"
	},
	"bugs": "https://github.com/eisbachcode/emdash-plugin-analytics/issues",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./astro": {
			"import": "./dist/astro/index.mjs",
			"types": "./dist/astro/index.d.mts"
		}
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build && tsdown",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"registry:login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"prepublishOnly": "pnpm run build",
		"build:astro": "tsdown",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"engines": {
		"node": ">=22.16"
	},
	"peerDependencies": {
		"emdash": ">=1.0.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@emdash-cms/blocks": "1.0.1",
		"@emdash-cms/plugin-cli": "0.13.1",
		"@emdash-cms/plugin-test": "0.2.6",
		"emdash": "^1.0.1",
		"tsdown": "0.20.3",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "4.5.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.15.1"
}
