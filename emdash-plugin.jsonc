{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "emdash-umami-analytics",
	"publisher": "did:plc:efxj3t72atnke555mnnmywju",

	"license": "MIT",
	"author": { "name": "Shane Lord", "url": "https://github.com/shanelord01" },
	"security": { "url": "https://github.com/shanelord01/emdash-umami-analytics/security/advisories/new" },
	"repo": "https://github.com/shanelord01/emdash-umami-analytics",

	// The only version check a user meets before installing. EmDash refuses
	// an install whose host falls outside this range, so it carries a floor
	// and deliberately no ceiling: EmDash ships a minor every 6-8 days, and
	// a ceiling would block correct installs every week rather than catch a
	// break. The manifest has no advisory "tested up to" field to express
	// caution without blocking, so the tested range belongs in the README.
	//
	// Listing images live in `images/`, which the bundle leaves out. The
	// banner is 1536x512 because the registry shows it at 3:1, and at that
	// shape link previews show it whole. Screenshots would go under
	// `release.artifacts.screenshots`. There are none yet.
	"release": {
		"requires": { "env:emdash": ">=1.0.1" },
		"artifacts": {
			"icon": { "file": "./images/icon.webp" },
			"banner": { "file": "./images/banner.webp" }
		}
	},

	// Registry results, and the Plugins list of a registry install, show this;
	// without it they show the slug. In-process installs always show the slug.
	"name": "Umami Analytics",

	// Registry search matches the description and the keywords, so the
	// provider this plugin reads is named in both.
	//
	// `emdash-plugin validate` allows five keywords at most.
	//
	// The registry profile refuses a description over 140 graphemes.
	// `emdash-plugin validate` accepts up to 1,024 characters, so the failure
	// only shows at `release setup` or publish.
	"description": "Umami analytics on the EmDash dashboard and next to your content: traffic, top pages, referrers, countries and views per entry.",
	"keywords": ["analytics", "umami", "dashboard", "widget", "content"],

	// Trust contract.
	//
	// `content:read` and `schema:read` are the content join: the plugin
	// asks the schema which collections are routable, asks the content API
	// where each entry is published, and stores that mapping.
	//
	// `network:request:unrestricted`, with `allowedHosts` empty as that
	// capability requires, because a self-hosted Umami lives on a host the
	// operator types into the settings, which no allow-list written here
	// can name. The plugin requests one place only: the Umami API URL from
	// the settings (`api.umami.is` unless changed).
	//
	// Deliberately absent: `content:write` (this plugin reports, it never
	// edits), `users:read`, `email:send`. Nothing about your content leaves
	// the site: the outbound request carries a website ID and hostnames.
	"capabilities": ["content:read", "schema:read", "network:request:unrestricted"],
	"allowedHosts": [],

	"storage": {
		// The fact table: one row per (day, path).
		//
		// Rows freeze once their day is closed and was read from an
		// unsampled response (see src/sync/window.ts). The history pass may
		// still correct one, because Umami is exact at any age.
		"daily": { "indexes": ["date", "path"] },

		// Site totals per day, read straight into the widget's chart.
		"rollup": { "indexes": ["date"] },

		// The path -> entry join, maintained forward from the content hooks.
		//
		// `views30` and `views7` are indexed because the content page sorts
		// by them and storage rejects an orderBy on an undeclared index.
		// Every index costs one more D1 row per write, which is why the
		// sync does read-compare-write instead of blind upserts.
		"entries": {
			"indexes": ["path", "collection", "entryId", "translationGroup", "views30", "views7"]
		}
	},

	"admin": {
		// The only settings surface. The generated form is the
		// platform-standard place for credentials and cannot be suppressed,
		// so the plugin does not add a second one that would drift from it.
		//
		// `secret` is what triggers AES-GCM encryption with
		// EMDASH_ENCRYPTION_KEY. Without that key set, saving throws
		// PLUGIN_SETTING_ENCRYPTION_KEY_MISSING rather than storing
		// plaintext — the widget says so in plain words.
		"settingsSchema": {
			"provider": {
				"type": "select",
				"label": "Data source",
				"default": "umami",
				"options": [
					{ "value": "umami", "label": "Umami (Cloud or self-hosted)" },
					{ "value": "demo", "label": "Demo data (generated, not real traffic)" }
				],
				"description": "Umami for your real numbers. Demo data needs no account and fills the pages with made-up traffic. Switching clears the stored numbers."
			},
			"umamiApiUrl": {
				"type": "url",
				"label": "Umami API URL",
				"default": "https://api.umami.is/v1",
				"placeholder": "https://analytics.example.com/api",
				"description": "Where the plugin reaches Umami. For your own Umami, its address with /api on the end, for example https://analytics.example.com/api, on a public hostname. Leave the default for Umami Cloud (untested)."
			},
			"umamiApiKey": {
				"type": "secret",
				"label": "Umami API key",
				"description": "Create it in Umami under Settings > API keys, signed in as a view-only user who can see this website. Self-hosted Umami has API keys from 3.4.0."
			},
			"umamiWebsiteId": {
				"type": "string",
				"label": "Umami website ID",
				"description": "From the website's settings in Umami: 36 characters such as 12345678-abcd-4ef0-9876-0123456789ab. Leave empty and the dashboard card lists the websites the key can see, to copy one from."
			},
			"hosts": {
				"type": "string",
				"label": "Hostnames to count",
				"description": "Leave empty to count your site's address and its www form. Otherwise a comma-separated list, for example example.com, www.example.com. Other hostnames, such as preview deploys, are not counted."
			},
			"breakdownProperties": {
				"type": "string",
				"label": "Break down page views by",
				"default": "category",
				"description": "Event data your site attaches to its page views, up to three, comma-separated, for example category, section, tags. The Analytics page shows page views for each value. Leave empty for none."
			},
			"readThrough": {
				"type": "boolean",
				"label": "Read-through",
				"default": true,
				"description": "Shows how far readers get through each post, from a reading event your site sends. Uses the four fields below; turn off to stop without clearing them."
			},
			"readEvent": {
				"type": "string",
				"label": "Reading event",
				"description": "The custom event your site sends as a reader gets further through a post, for example post_read. Leave empty if your site sends none."
			},
			"readEntryProperty": {
				"type": "string",
				"label": "Post property",
				"description": "The event's property that names the post, by its slug or its path, for example post."
			},
			"readDepthProperty": {
				"type": "string",
				"label": "Progress property",
				"description": "The event's property that says how far the reader got, for example depth."
			},
			"readDepthValues": {
				"type": "string",
				"label": "Reading milestones",
				"description": "The progress property's values in reading order, comma-separated, up to three, for example half, end."
			},
			"timeZone": {
				"type": "string",
				"label": "Time zone",
				"default": "Australia/Sydney",
				"description": "The time zone your days are counted in, as an IANA name such as Australia/Sydney, Europe/Berlin or UTC. Use the one set for the website in Umami, so both show the same days. A name that is not recognised counts as Australia/Sydney. Changing it clears the stored numbers, which are then read again."
			},
			"syncInterval": {
				"type": "select",
				"label": "Sync every",
				"default": "*/15 * * * *",
				"options": [
					{ "value": "*/15 * * * *", "label": "15 minutes" },
					{ "value": "*/30 * * * *", "label": "30 minutes" },
					{ "value": "0 * * * *", "label": "Hour" },
					{ "value": "0 */6 * * *", "label": "6 hours" }
				],
				"description": "How often the plugin reads new numbers from Umami. After install it catches up faster on its own."
			},
			"retentionDays": {
				"type": "number",
				"label": "Keep daily history for",
				"description": "Days, 7 to 400. After install the plugin reads this far back from Umami, and deletes older days.",
				"default": 90,
				"min": 7,
				"max": 400
			},
			"chunkSize": {
				"type": "number",
				"label": "Entries per sync step",
				"description": "10 to 36. Lower it only if the site runs on Cloudflare D1's free plan, to write fewer database rows a day.",
				"default": 36,
				"min": 10,
				"max": 36
			}
		},

		"pages": [
			{ "path": "/analytics", "label": "Analytics", "icon": "chart-line" },
			{ "path": "/analytics/content", "label": "Analytics per entry", "icon": "chart" }
		],
		"widgets": [{ "id": "traffic", "title": "Traffic", "size": "half" }],

		// Opens beside the entry editor, in every collection: the plugin
		// cannot know at build time which collections a site routes, and
		// an entry without a page says so in the panel.
		//
		// "Analytics" because manifest strings cannot be translated, and it
		// reads the same in English and German; "Views" sat in English above
		// a German panel.
		"editorPanels": [{ "id": "views", "title": "Analytics", "route": "panel" }]
	},

	// The registry page's tabs. Profile-level: they carry across releases.
	// Each file is capped at 20000 bytes and 2000 graphemes
	// (tests/docs.test.ts checks both).
	"sections": {
		"description": { "file": "docs/registry/description.md" },
		"installation": { "file": "docs/registry/installation.md" },
		"faq": { "file": "docs/registry/faq.md" },
		"changelog": { "file": "docs/registry/changelog.md" },
		"security": { "file": "docs/registry/security.md" }
	}

	// No `hooks` and no `routes` here: the authored manifest is strict and
	// rejects both. They live in src/plugin.ts and the build probes them
	// into the wire manifest.
}
